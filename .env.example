# ForgeRun Environment Configuration (Development Defaults)

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://forgerun:forgerun_dev_password@localhost:5432/forgerun
DATABASE_URL_SYNC=postgresql://forgerun:forgerun_dev_password@localhost:5432/forgerun

# Cache & Hot State (Redis 7.2)
REDIS_URL=redis://localhost:6379/0

# Event Backbone (Kafka / Redpanda)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_SUBMISSION_CREATED=forge.submission.created.v1
KAFKA_TOPIC_EXECUTION_SCHEDULED=forge.execution.scheduled.v1
KAFKA_TOPIC_EXECUTION_STARTED=forge.execution.started.v1
KAFKA_TOPIC_EXECUTION_COMPLETED=forge.execution.completed.v1
KAFKA_TOPIC_EXECUTION_FAILED=forge.execution.failed.v1
KAFKA_TOPIC_DEADLETTER=forge.deadletter.v1

# Security & Authentication
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=forgerun.io
JWT_AUDIENCE=forgerun-api

# Runner & Sandbox Policy
SANDBOX_RUNTIME_CLASS=runc
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_MB=256
MAX_OUTPUT_BYTES=65536
MAX_CONCURRENT_ATTEMPTS=50

# Observability (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=forgerun-api
LOG_LEVEL=INFO
