{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgerun.io/schemas/execution.failed.v1.json",
  "title": "ExecutionFailedPayload",
  "type": "object",
  "properties": {
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "failure_type": {
      "type": "string",
      "enum": ["USER_CODE", "INFRASTRUCTURE", "TIMEOUT", "SANDBOX_ERROR"]
    },
    "error_message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": ["object", "null"]
    }
  },
  "required": [
    "attempt_id",
    "submission_id",
    "failure_type",
    "error_message",
    "retryable"
  ],
  "additionalProperties": false
}
