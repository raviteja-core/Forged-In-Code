{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgerun.io/schemas/envelope.json",
  "title": "EventEnvelope",
  "description": "Standardized ForgeRun event envelope for Kafka",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "producer": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "correlation_id",
    "producer",
    "payload"
  ],
  "additionalProperties": false
}
